---
import Link from '@/shared/components/Link.astro'

interface Props {
  link: string
  title: string
  class?: string
  description?: string
}

const { link, title, class: extraClass, description } = Astro.props
---

<Link to={link} class={extraClass}>
  <article class="card-shadow flex cursor-pointer flex-col gap-y-4 rounded-xl p-4 sm:p-8">
    <h3 class="text-2xl font-extrabold">{title}</h3>
    {description && <p class="text-lg">{description}</p>}
  </article>
</Link>
