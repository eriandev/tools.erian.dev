---
import type { AstroLinkProps } from './types'

interface Props extends AstroLinkProps {}

const { to, external = false, ...restProps } = Astro.props
const rel = external ? 'noopener noreferrer' : null
const target = external ? '_blank' : null
---

<a {rel} {target} href={to} {...restProps}>
  <slot />
</a>
