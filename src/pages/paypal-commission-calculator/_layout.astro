---
import MetaTags, { type MetaTagsProps } from '@/components/MetaTags.astro'
import './_styles.css'

interface Props extends MetaTagsProps {}

const { title, description, slug, class: bodyClass } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <MetaTags {title} {description} {slug} themeColor="#070439" />

    <style>
      @font-face {
        font-weight: 400;
        font-family: 'Ubuntu';
        font-style: normal;
        font-display: swap;
        src: url('/fonts/ubuntu-400.woff2') format('woff2');
      }

      @font-face {
        font-weight: 500;
        font-family: 'Ubuntu';
        font-style: normal;
        font-display: swap;
        src: url('/fonts/ubuntu-500.woff2') format('woff2');
      }
    </style>

    <script src="./_scripts/declareRefs.ts"></script>
    <script src="./_scripts/events.ts"></script>
  </head>

  <body class:list={['font-ubuntu min-h-screen text-gray-900 dark:bg-gray-900 dark:text-white', bodyClass]}>
    <slot />
  </body>
</html>
