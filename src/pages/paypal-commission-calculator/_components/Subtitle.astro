---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'h2'> {
  as?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
}

const { as: Tag = 'h2', class: extraClass, ...restProps } = Astro.props
---

<Tag class:list={['text-center text-2xl font-bold tracking-tight', extraClass]} {...restProps}>
  <slot />
</Tag>
