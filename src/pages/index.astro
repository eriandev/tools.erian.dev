---
import { get } from 'shared/utils/http'
import Layout from 'shared/components/Layout.astro'
import type { Site } from 'shared/types'

import Card from '@/components/Card.astro'

interface PageTexts {
  title: string
  description?: string
  subtitle?: string
}

const { PUBLIC_API_URL: API_URL } = import.meta.env

const readmeList = await Astro.glob('../../sites/*/README.md')
const sites = readmeList.map(({ frontmatter }) => ({ ...(frontmatter as Site) }))
const centerCardClass = 'w-full md:col-span-2 md:max-w-[31rem] md:justify-self-center'

const { title, description, subtitle } = await get<PageTexts>(API_URL + '/landing/')
---

<Layout {title} {description} class="grid grid-rows-2">
  <section
    class="grid min-h-80 grid-rows-[repeat(2,min-content)] content-center justify-items-center gap-y-4 bg-teal-100 px-4 py-16 text-center"
  >
    <h1 class="text-4xl font-extrabold md:text-5xl">{title}</h1>
    <h2 class="max-w-2xl text-pretty text-xl md:text-2xl">{description}</h2>
  </section>

  <section class="flex flex-col items-center px-6 lg:px-4">
    <p class="py-16 text-center text-2xl font-bold md:text-3xl">{subtitle}</p>

    <main class="grid w-full max-w-5xl gap-8 pb-16 md:grid-cols-2">
      {
        sites.map(({ description, slug, title }, index) => (
          <Card
            {title}
            {description}
            link={'/' + slug}
            class={index === sites.length - 1 ? centerCardClass : undefined}
          />
        ))
      }
    </main>
  </section>
</Layout>
