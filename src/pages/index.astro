---
import Layout from './_layout.astro'
import Card from '@/components/Card.astro'
import { get } from '@/shared/utils/http.ts'
import { API_URL } from '@/shared/consts.ts'
import { isEven } from '@/shared/utils/number.ts'
import type { PageApiResponse } from '@/shared/types.ts'

const { title, subtitle, description, sites } = await get<PageApiResponse>(API_URL)
const centerCardClass = 'w-full md:col-span-2 md:max-w-[31rem] md:justify-self-center'
---

<Layout {title} {description} class="grid grid-rows-2">
  <section
    class="grid min-h-80 grid-rows-[repeat(2,min-content)] content-center justify-items-center gap-y-4 bg-teal-100 px-4 py-16 text-center"
  >
    <h1 class="text-4xl font-extrabold md:text-5xl">{title}</h1>
    <h2 class="max-w-2xl text-xl text-pretty md:text-2xl">{description}</h2>
  </section>

  <section class="flex flex-col items-center px-6 lg:px-4">
    <p class="py-16 text-center text-2xl font-bold md:text-3xl">{subtitle}</p>

    <main class="grid w-full max-w-5xl gap-8 pb-16 md:grid-cols-2">
      {
        sites.map(({ slug, title, description }, index) => (
          <Card
            {title}
            {description}
            link={'/' + slug}
            class={!isEven(sites.length) && index === sites.length - 1 ? centerCardClass : undefined}
          />
        ))
      }
    </main>
  </section>
</Layout>
