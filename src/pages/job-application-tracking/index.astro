---
import Layout from './_layout.astro'
import Board from './_components/Board.svelte'

const slug = 'job-application-tracking'
const title = 'Job Application Tracking'
const description = 'App to help users organize, track and save their job applications.'
---

<Layout {title} {slug} {description}>
  <h1 class="px-5 pb-5 pt-10 text-[2rem] md:px-8">{title}</h1>

  <main class="flex gap-x-8 overflow-x-auto px-5 md:px-8">
    <Board client:load />
  </main>
</Layout>
