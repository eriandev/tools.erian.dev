---
import Icon from '@/shared/components/Icon.astro'
import { BOARD_INFO_KEY } from '../_utils/consts'
import type { JobApplicationStatus } from '../_utils/types'

interface Props {
  headline: JobApplicationStatus
}

const { headline } = Astro.props
const iconName = `${BOARD_INFO_KEY}/${headline}` as const
---

<section class="max-w-xs min-w-[320px] pb-10">
  <header class="mb-2 flex flex-col gap-y-3">
    <div class="grid grid-cols-[fit-content(100%)_auto_fit-content(100%)] items-center gap-x-2">
      <Icon name={iconName} size={20} />
      <h2 class="text-xl capitalize">{headline}</h2>
      <!-- <div class="h-5 w-5 animate-pulse rounded-full bg-slate-200"></div> -->
      <div class="text-theme-black grid size-5 place-items-center rounded-full bg-white text-xs font-medium"></div>
    </div>
    <button
      class="bg-theme-gray-100 text-theme-gray-400 w-full rounded-lg py-2 text-center font-medium transition-transform duration-150 ease-in-out active:scale-95 disabled:opacity-50 disabled:active:scale-100"
    >
      + Add Job
    </button>
  </header>

  <slot />
</section>
