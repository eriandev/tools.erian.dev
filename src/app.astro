---
import { BASE_URL } from 'shared/utils/env'
import BaseLayout from 'shared/components/BaseLayout.astro'
import type { BodyProps, HTMLProps } from 'shared/components/types'
import '@/app.css'

interface Props {
  title: string
  slug?: string
  class?: string
  description: string
  themeColor?: string
}

const { title, description, themeColor, class: bodyClass } = Astro.props
const html: HTMLProps = { lang: 'en' }
const body: BodyProps = { 'class:list': ['min-h-screen', bodyClass] }
---

<BaseLayout baseUrl={BASE_URL} {html} {body} {title} {description} {themeColor}>
  <slot />
</BaseLayout>
