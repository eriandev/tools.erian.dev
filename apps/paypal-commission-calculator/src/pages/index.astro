---
import Layout from '@/app.astro'
import AmountInput from '@/components/AmountInput.astro'
import DiagonalBack from '@/components/DiagonalBack.astro'
import CopyValueInput from '@/components/CopyValueInput.astro'

const slug = 'paypal-commission-calculator'
const title = 'Paypal Commission Calculator'
const description =
  'Tool designed to quickly and accurately calculate the commissions charged by PayPal on transactions.'
---

<Layout {title} {slug} {description}>
  <div class="relative flex h-full min-h-dvh overflow-x-hidden">
    <section
      class="fixed top-0 right-0 left-0 z-10 mx-auto w-full max-w-2xl gap-y-2 rounded-b-[64px] bg-white p-4 text-black"
    >
      <span class="mx-auto block w-max font-secondary text-xl">5.4 % + $0.30</span>
    </section>

    <DiagonalBack position="left" />
    <DiagonalBack position="right" />

    <main
      class="absolute top-1/2 right-0 left-0 z-10 mx-auto my-0 grid w-full max-w-2xl -translate-y-1/2 gap-y-10 lg:gap-y-24"
    >
      <h1 class="text-center text-3xl lg:text-5xl">Paypal Commission Calculator</h1>

      <section class="grid gap-y-4 text-center md:flex">
        <article class="grid justify-items-center gap-y-4 lg:w-1/2">
          <CopyValueInput id="send" label="You must to send" />
          <CopyValueInput id="send-commission" label="Commission" />
        </article>

        <article class="grid justify-items-center gap-y-4 lg:w-1/2">
          <CopyValueInput id="receive" label="You will recieve" />
          <CopyValueInput id="receive-commission" label="Commission" />
        </article>
      </section>
    </main>

    <AmountInput />
  </div>
</Layout>
