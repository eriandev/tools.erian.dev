---
import Layout from '@/app.astro'
import Block from '@/components/Block.astro'
import Title from '@/components/Title.astro'
import Input from '@/components/Input.astro'
import Subtitle from '@/components/Subtitle.astro'

const slug = 'paypal-commission-calculator'
const title = 'Paypal Commission Calculator'
const description =
  'Tool designed to quickly and accurately calculate the commissions charged by PayPal on transactions.'
---

<Layout {title} {slug} {description}>
  <header class="flex w-full justify-center px-6 py-16 text-center">
    <Title>Paypal Commission Calculator</Title>
  </header>

  <section>
    <Block>
      <Subtitle>Paypal Commission</Subtitle>

      <div class="mt-6 flex items-center justify-center gap-1.5">
        <Input id="percent-commision" value="5.4" class="w-16 text-center text-xl font-bold" readonly />
        <span class="font-bold">%</span>
        <span class="text-2xl font-bold">+</span>
        <span class="font-bold">$</span>
        <Input id="fixed-commision" value="0.3" class="w-16 text-center text-xl font-bold" readonly />
      </div>
    </Block>
  </section>

  <article class="mx-auto my-12 grid max-w-xs gap-3">
    <Subtitle>Amount</Subtitle>

    <Input
      id="amount"
      type="number"
      autocomplete="off"
      class="w-full input-appearance-none py-2 text-center text-2xl font-bold"
      onkeypress="return isOnlyNumbers(event)"
    />
  </article>

  <section class="grid justify-center gap-6 pb-24 md:grid-cols-[repeat(2,fit-content(100%))] md:gap-12">
    <Block>
      <Subtitle>Send</Subtitle>

      <div class="mt-6 flex flex-col gap-3">
        <div class="grid grid-cols-[80px_auto_1fr] items-center gap-2">
          <span class="text-right">Sends</span>
          <Input id="send" class="w-full py-2" readonly />
          <span>USD</span>
        </div>

        <div class="grid grid-cols-[80px_auto_1fr] items-center gap-2">
          <span class="text-right">Comission</span>
          <Input id="send-comission" class="w-full py-2" readonly />
          <span>USD</span>
        </div>
      </div>
    </Block>

    <Block>
      <Subtitle>Receive</Subtitle>

      <div class="mt-6 flex flex-col gap-3">
        <div class="grid grid-cols-[80px_auto_1fr] items-center gap-2">
          <span class="text-right">Receives</span>
          <Input id="receive" class="w-full py-2" readonly />
          <span>USD</span>
        </div>

        <div class="grid grid-cols-[80px_auto_1fr] items-center gap-2">
          <span class="text-right">Comission</span>
          <Input id="receive-comission" class="w-full py-2" readonly />
          <span>USD</span>
        </div>
      </div>
    </Block>
  </section>
</Layout>
