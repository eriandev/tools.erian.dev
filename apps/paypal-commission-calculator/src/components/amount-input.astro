---
interface Props {
  id: string
}

const { id } = Astro.props
---

<input
  {id}
  autofocus
  type="number"
  autocomplete="off"
  placeholder="Amount"
  onkeypress="return isOnlyNumbers(event)"
  class="absolute right-0 bottom-4 left-0 z-20 mx-auto w-full max-w-2xl input-appearance-none rounded-3xl border border-gray-500 bg-white px-6 py-3 text-center font-primary text-4xl/none font-bold text-back-secondary input-shadow"
/>
