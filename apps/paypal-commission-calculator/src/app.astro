---
import { BASE_URL } from 'shared/utils/env'
import BaseLayout from 'shared/components/base-layout.astro'
import type { BodyProps, HTMLProps } from 'shared/components/types'
import '@/app.css'

interface Props {
  title: string
  slug?: string
  class?: string
  description: string
}

const { title, description, slug, class: bodyClass } = Astro.props
const html: HTMLProps = { lang: 'en' }
const body: BodyProps = {
  'class:list': ['font-primary text-white', bodyClass],
}
---

<BaseLayout baseUrl={BASE_URL} {html} {body} {title} {description} {slug} themeColor="#005EA6">
  <Fragment slot="head">
    <style is:inline>
      @font-face {
        font-display: swap;
        font-family: 'PayPal Sans Big';
        font-style: normal;
        font-weight: 300;
        src: url('/paypal-commission-calculator/fonts/paypal-sans-small-300.woff2') format('woff2');
      }

      @font-face {
        font-display: swap;
        font-family: 'PayPal Sans Small';
        font-style: normal;
        font-weight: 400;
        src: url('/paypal-commission-calculator/fonts/paypal-sans-big-400.woff2') format('woff2');
      }

      @font-face {
        font-display: swap;
        font-family: 'PayPal Open';
        font-style: normal;
        font-weight: 400;
        src: url('/paypal-commission-calculator/fonts/paypal-open-400.woff2') format('woff2');
      }

      @font-face {
        font-display: swap;
        font-family: 'PayPal Open';
        font-style: normal;
        font-weight: 600;
        src: url('/paypal-commission-calculator/fonts/paypal-open-600.woff2') format('woff2');
      }
    </style>

    <script src="@/logic/declare-refs.ts"></script>
    <script src="@/logic/events.ts"></script>
  </Fragment>
  <wc-toast></wc-toast>
  <slot />
</BaseLayout>
