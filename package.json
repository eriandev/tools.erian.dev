{
  "name": "tools.erian.dev",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "astro build && pnpm all:run build",
    "check": "astro check --tsconfig tsconfig.json",
    "format": "prettier --write . && pnpm all:run format",
    "all:run": "pnpm -r --stream --workspace-concurrency 3",
    "lint": "prettier --check . && eslint . && pnpm all:run lint",
    "clean": "rm -rf .astro dist node_modules && pnpm all:run clean"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "astro": "6.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/svelte": "8.1.1",
    "@types/node": "25.9.0",
    "eslint": "10.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "3.5.2",
    "prettier-plugin-tailwindcss": "0.8.0",
    "shared": "workspace:*",
    "svelte": "5.55.8",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.3"
  }
}
