    "eslint-plugin-svelte": "2.32.4",
    "prettier": "2.8.8",
    "prettier-plugin-svelte": "2.10.1",
    "prettier-plugin-tailwindcss": "0.3.0",
    "standard": "17.1.0",
    "svelte": "4.1.1",
    "svelte-check": "3.4.6",
    "tailwindcss": "3.3.3",
    "typescript": "5.1.6",
    "vite": "4.4.7"
  }
}
