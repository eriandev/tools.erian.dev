{
  "name": "erian.tools",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "pnpm check && astro build",
    "check": "astro check --tsconfig tsconfig.json",
    "all:run": "pnpm -r --stream --workspace-concurrency 3",
    "lint": "eslint --fix {src,sites,packages}/**/*.{astro,ts}",
    "format": "prettier --write {src,sites,packages}/**/*.{astro,ts}",
    "build:prod": "pnpm build && pnpm all:run build"
  },
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=8.15.0"
  },
  "dependencies": {
    "astro": "4.16.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/tailwind": "5.1.2",
    "eslint-config-custom": "workspace:*",
    "shared": "workspace:*",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
