---
import { Icon as AstroIcon } from 'astro-icon/components'
import type { AstroIconProps } from 'shared/components/types'

interface Props extends AstroIconProps {}

const { name, size, width, height, ...restProps } = Astro.props
---

<AstroIcon {name} width={size ?? width} height={size ?? height} {...restProps} />
